"""ExternalDNS webhook provider for Infoblox Universal DDI (bzlmod root module)."""

module(
    name = "external_dns_uddi_webhook",
    version = "0.0.0",
    bazel_compatibility = [">=9.0.0"],
)

# Go: rules_go >= 0.63.0 is required on Bazel 9.x (0.62 crashes with duplicate
# mingw constraints, bazel-contrib/rules_go#4665). gazelle 0.54.0 generates the
# BUILD files under cmd/ and internal/ (`bazel run //:gazelle`).
bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.54.0")

# OCI image: distroless base + multi-arch index, pushed to ghcr.
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")  # tar (app layer), platform_transition_filegroup

# Declared directly (not just transitively) so oci_pull'd base image repos can
# resolve the @package_metadata loads that rules_oci 2.3 emits.
bazel_dep(name = "package_metadata", version = "0.0.13")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_shell", version = "0.8.0")

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.4", dev_dependency = True)

# --- Go toolchain + module deps --------------------------------------------
# SDK version comes from go.mod (`toolchain` directive, else `go`).
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

# go_deps reads go.mod and go.sum and does not add Go modules to
# MODULE.bazel.lock. List direct dependencies here. After adding one to go.mod,
# run `bazel mod tidy` or `bazel run @rules_go//go -- mod tidy`.
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_caarlos0_env_v11",
    "com_github_infobloxopen_universal_ddi_go_client",
    "com_github_prometheus_client_golang",
    "com_github_stretchr_testify",
    "io_k8s_sigs_external_dns",
)

# --- Base image --------------------------------------------------------------
# gcr.io/distroless/static-debian12:nonroot (uid/gid 65532). `tag` is kept so
# Renovate's docker datasource can track it; `digest` pins it. Index digest
# verified 2026-09-13 (docs/research-notes.md section 4).
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless_static",
    digest = "sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab",
    image = "gcr.io/distroless/static-debian12",
    # The index lists arm64 with variant v8, and rules_oci matches the full
    # os/arch/variant string, so a bare "linux/arm64" finds no manifest.
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
    tag = "nonroot",
)
use_repo(oci, "distroless_static", "distroless_static_linux_amd64", "distroless_static_linux_arm64_v8")

# --- sonar-scanner-cli (hermetic) -------------------------------------------
# The `-linux-x64` distribution bundles its own JRE, so this needs no Java
# toolchain and nothing on host PATH. Driven by //tools/sonar:scan (the
# post-merge sonar-scan CI job). Same pin as the bombora repo.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "sonar_scanner_cli",
    build_file_content = """
exports_files(["bin/sonar-scanner"], visibility = ["//visibility:public"])

filegroup(
    name = "dist",
    srcs = glob(["**"], exclude = ["**/* *"]),
    visibility = ["//visibility:public"],
)
""",
    sha256 = "7c201e1f16e64906da8fa7b77b3bda62e9c570f44323db763b4d083e0a1dbcd2",
    strip_prefix = "sonar-scanner-7.3.0.5189-linux-x64",
    urls = ["https://binaries.sonarsource.com/Distribution/sonar-scanner-cli/sonar-scanner-cli-7.3.0.5189-linux-x64.zip"],
)

# --- cc toolchain (hermetic; never actually compiles anything) ---------------
# Pure Go needs no C compiler, but several stock tools still REQUIRE a
# @bazel_tools//tools/cpp:toolchain_type to resolve at analysis time
# (`bazel run @rules_go//go`, the launcher_maker behind py/java binaries such as
# Bazel's coverage lcov_merger). Host autodetection is off (.bazelrc:
# BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1) because neither the nix devshell nor the
# bb-ci-worker runner has gcc, so register the zig-based hermetic toolchain
# instead: one ~50 MB download, and it rides along to RBE workers as an input
# only if a cc action ever runs (none does).
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")

zig_toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(zig_toolchains, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain:linux_amd64_gnu.2.28",
    "@zig_sdk//toolchain:linux_arm64_gnu.2.28",
)
