# Bazel runs locally unless the caller selects --config=remote.

# Use the same local cache path in development and CI.
build --disk_cache=~/.cache/bazel-disk

# Build the optimized binary used by the container image.
build -c opt

# The project does not use cgo. Disable host C toolchain detection so analysis
# also works on machines without a C compiler.
build --@rules_go//go/config:pure=true
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1

test --test_output=errors
test --test_verbose_timeout_warnings

build --show_progress_rate_limit=5
build --jobs=4

# Keep --config=local as a compatible spelling for scripts and old commands.
common:local --remote_executor=
common:local --remote_cache=
common:local --bes_backend=
build:local --remote_download_toplevel

# Wayvz CI overrides the endpoints with its bb-clientd socket. The remaining
# settings describe the Buildbarn execution platform and output policy.
build:remote --remote_executor=grpc://bb.lab.wayvz.io:8980
build:remote --remote_instance_name=
build:remote --remote_timeout=3600
build:remote --verbose_failures
build:remote --remote_default_exec_properties=OSFamily=linux
build:remote --remote_default_exec_properties=cpu=x86_64
build:remote --remote_default_exec_properties=container-image=docker://ghcr.io/catthehacker/ubuntu:act-22.04
build:remote --bes_backend=grpc://bb-portal.lab.wayvz.io:8082
build:remote --bes_results_url=https://bb-portal.lab.wayvz.io/bazel-invocations/
build:remote --remote_download_minimal
build:remote --experimental_remote_cache_eviction_retries=5
build:remote --extra_execution_platforms=//tools/remote-toolchains:remote_platform
build:remote --shell_executable=/bin/bash
build:remote --action_env=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
build:remote --host_action_env=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
build:remote --incompatible_strict_action_env

# Sonar reads native Go coverage profiles. The merge script combines the
# per-test coverage.dat files in target/sonar/go-coverage.out.
coverage --@rules_go//go/config:cover_format=go_cover
coverage --combined_report=none
coverage --instrumentation_filter=//...
coverage --remote_download_regex=.*/coverage\.dat$

# Load optional machine-specific settings last.
try-import %workspace%/.bazelrc.user
