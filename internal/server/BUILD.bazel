    deps = [
        "//internal/provider",
        "//internal/uddi",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@io_k8s_sigs_external_dns//endpoint",
        "@io_k8s_sigs_external_dns//pkg/apis/externaldns",
        "@io_k8s_sigs_external_dns//plan",
        "@io_k8s_sigs_external_dns//provider/webhook",
    ],
