load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "server",
    srcs = ["server.go"],
    importpath = "github.com/wayvz-io/external-dns-uddi-webhook/internal/server",
    visibility = ["//:__subpackages__"],
    deps = [
        "@com_github_prometheus_client_golang//prometheus/promhttp",
