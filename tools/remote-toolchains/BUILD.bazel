# Remote execution platform for the Wayvz Buildbarn cluster.
# Bazel sends the rules_go SDK to an Ubuntu worker as an external repository.
# The properties must match the scheduler's x86 queue exactly.
platform(
    name = "remote_platform",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    exec_properties = {
        "OSFamily": "linux",
        "cpu": "x86_64",
        "container-image": "docker://ghcr.io/catthehacker/ubuntu:act-22.04",
    },
    visibility = ["//visibility:public"],
)
