# Execution platform for Remote Build Execution on the lab Buildbarn cluster.
#
# The Go toolchain is downloaded (rules_go SDK), so Bazel ships it to the
# workers as an ordinary external repository; a vanilla Ubuntu act worker
# executes the actions with no special preparation. Used by --config=remote
# (see //.bazelrc). The lab scheduler advertises its x86 queue as the bare act
# tag (no digest) plus an explicit cpu property, so the exec_properties are
# matched verbatim to that queue -- change them and actions queue forever with
# no matching worker.
platform(
    name = "remote_platform",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    exec_properties = {
        "OSFamily": "linux",
        "cpu": "x86_64",
        "container-image": "docker://ghcr.io/catthehacker/ubuntu:act-22.04",
    },
    visibility = ["//visibility:public"],
)
