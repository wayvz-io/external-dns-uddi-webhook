load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

# Run the pinned SonarScanner with `bazel run --config=local //tools/sonar:scan`.
# The Linux distribution includes a JRE. `args` passes the launcher path to
# scan.sh, so the script does not need the canonical bzlmod repository name.
sh_binary(
    name = "scan",
    srcs = ["scan.sh"],
    args = ["$(rlocationpath @sonar_scanner_cli//:bin/sonar-scanner)"],
    data = [
		# rlocationpath requires the launcher to be a direct prerequisite.
        "@sonar_scanner_cli//:bin/sonar-scanner",
        "@sonar_scanner_cli//:dist",
    ],
    visibility = ["//visibility:public"],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)
