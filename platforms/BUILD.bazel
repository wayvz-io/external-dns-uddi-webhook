# Target platforms for the multi-arch container image (see //:image_index).
# Only os/cpu constraints: the Go toolchain is pure (no cgo), so no C toolchain
# has to resolve for either.

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
    visibility = ["//visibility:public"],
)
