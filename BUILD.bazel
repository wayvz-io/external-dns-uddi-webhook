load("@aspect_bazel_lib//lib:tar.bzl", "tar")
load("@aspect_bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@gazelle//:def.bzl", "gazelle")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_image_index", "oci_load", "oci_push")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# gazelle:prefix github.com/wayvz-io/external-dns-uddi-webhook
# gazelle:build_file_name BUILD.bazel
# gazelle:exclude deploy
# gazelle:exclude docs

# Regenerate cmd/** and internal/** BUILD files: `bazel run //:gazelle`.
# External Go deps are declared in MODULE.bazel (go_deps), so there is no
# `update-repos` step; `bazel mod tidy` refreshes the use_repo list instead.
gazelle(name = "gazelle")

exports_files(
    [
        "go.mod",
        "go.sum",
    ],
    visibility = ["//visibility:public"],
)

# ---------------------------------------------------------------------------
# Lint: BUILD file formatting (strict). `bazel run //:buildifier_check` locally,
# `bazel test //:buildifier_test` in CI.
# ---------------------------------------------------------------------------
sh_binary(
    name = "buildifier_check",
    srcs = ["//scripts:check_buildifier.sh"],
    args = ["$(rootpath @buildifier_prebuilt//:buildifier)"],
    data = ["@buildifier_prebuilt//:buildifier"],
    tags = ["lint"],
)

sh_test(
    name = "buildifier_test",
    size = "small",
    srcs = ["//scripts:check_buildifier.sh"],
    args = ["$(rootpath @buildifier_prebuilt//:buildifier)"],
    data = glob(
        [
            "*.bzl",
            "**/*.BUILD",
            "**/*.bzl",
            "**/BUILD.bazel",
            "**/BUILD",
        ],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ) + [
        "BUILD.bazel",
        "MODULE.bazel",
        "@buildifier_prebuilt//:buildifier",
    ],
    tags = ["lint"],
)

# ---------------------------------------------------------------------------
# Container image.
#
#   //:image        single-arch oci_image for the host/target platform
#   //:image_index  multi-arch index (linux/amd64 + linux/arm64)
#   //:load         `bazel run //:load` -> podman/docker image :dev
#   //:push         `bazel run --stamp --workspace_status_command=tools/workspace-status.sh //:push`
#
# //cmd/webhook:webhook is generated by gazelle from cmd/webhook/main.go.
# ---------------------------------------------------------------------------
# Hermetic bsdtar (aspect_bazel_lib), not rules_pkg: pkg_tar is a py_binary whose
# launcher needs a cc toolchain at analysis time.
tar(
    name = "app_layer",
    srcs = ["//cmd/webhook"],
    mtree = ["webhook uid=0 gid=0 mode=0755 time=0 type=file content=$(location //cmd/webhook)"],
)

oci_image(
    name = "image",
    base = "@distroless_static",
    entrypoint = ["/webhook"],
    exposed_ports = [
        "8888/tcp",
        "8080/tcp",
    ],
    labels = {
        "org.opencontainers.image.source": "https://github.com/wayvz-io/external-dns-uddi-webhook",
        "org.opencontainers.image.description": "ExternalDNS webhook provider for Infoblox Universal DDI",
        "org.opencontainers.image.licenses": "Apache-2.0",
    },
    tars = [":app_layer"],
    user = "nonroot",
    visibility = ["//visibility:public"],
)

# One transition per platform: the Go binary inside cross-compiles (pure mode).
platform_transition_filegroup(
    name = "image_linux_amd64",
    srcs = [":image"],
    target_platform = "//platforms:linux_amd64",
)

platform_transition_filegroup(
    name = "image_linux_arm64",
    srcs = [":image"],
    target_platform = "//platforms:linux_arm64",
)

oci_image_index(
    name = "image_index",
    images = [
        ":image_linux_amd64",
        ":image_linux_arm64",
    ],
    visibility = ["//visibility:public"],
)

# Local smoke test: `bazel run //:load && podman run --rm ghcr.io/wayvz-io/external-dns-uddi-webhook:dev`
oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["ghcr.io/wayvz-io/external-dns-uddi-webhook:dev"],
)

# Remote tags, one per line. Always `latest`; plus `vX.Y.Z` and `vX.Y` when
# STABLE_GIT_TAG (from tools/workspace-status.sh under --stamp) is a semver tag.
# stamp = 1 makes bazel-out/stable-status.txt an input even in --nostamp builds
# (it is then just missing the STABLE_* keys, so only `latest` is emitted).
genrule(
    name = "image_tags",
    outs = ["image_tags.txt"],
    cmd = """
tag=$$(grep -E '^STABLE_GIT_TAG ' bazel-out/stable-status.txt | cut -d' ' -f2- || true)
echo latest > $@
if [[ "$$tag" =~ ^v[0-9]+\\.[0-9]+\\.[0-9]+$$ ]]; then
  echo "$$tag" >> $@
  echo "$${tag%.*}" >> $@
fi
""",
    stamp = 1,
)

oci_push(
    name = "push",
    image = ":image_index",
    remote_tags = ":image_tags",
    repository = "ghcr.io/wayvz-io/external-dns-uddi-webhook",
)
